# --- Database -------------------------------------------------------
# Free Postgres options: Neon (neon.tech) or Supabase (supabase.com)
#
# DATABASE_URL: the POOLED connection string (hostname includes "-pooler"
# on Neon). The running app uses this. Pooled connections avoid the
# "Error in PostgreSQL connection: kind: Closed" errors that serverless
# Postgres providers cause with long-lived direct connections.
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT_URL: the DIRECT (non-pooled) connection string. Only
# `prisma migrate` and `prisma db seed` use this.
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require"

# --- Auth (NextAuth / Auth.js) ---------------------------------------
# Generate a secret with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Admin seed account -----------------------------------------------
# Used only by prisma/seed.ts to create the one admin user.
# Change the password after your first login isn't supported yet —
# for now, update it by re-running the seed with a new value.
ADMIN_EMAIL="vincent@example.com"
ADMIN_PASSWORD="change-this-before-seeding"

# --- Image uploads (UploadThing) --------------------------------------
# Get these from uploadthing.com after creating a free app
UPLOADTHING_TOKEN=""
