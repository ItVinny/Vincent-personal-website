// Prisma schema for the Vincent Omolo portfolio admin system.
// Run `npx prisma migrate dev --name <description>` after any change here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the running app
  directUrl = env("DIRECT_URL")   // direct connection, used only for migrations
}

// ============================================
// AUTH
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash — never store plain text
  name      String?

  // Password brute-force protection: incremented on each failed
  // password check, reset on success. Enforced in
  // lib/actions/two-factor.ts (requestLoginCode), since that's where
  // the password is actually checked now -- see the two-factor note
  // below for why.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Email-based two-factor login code. The flow is two steps:
  // 1. requestLoginCode checks the password, and on success generates,
  //    hashes, and emails a 6-digit code here, instead of signing in.
  // 2. lib/auth.ts's Credentials authorize() -- the step that actually
  //    issues a session -- checks THIS code, not the password.
  // twoFactorAttempts caps wrong-code guesses separately from the
  // password lockout above; a code is single-use and cleared once
  // consumed or replaced by a fresh one.
  twoFactorCodeHash   String?
  twoFactorExpiresAt  DateTime?
  twoFactorAttempts   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// MEDIA LIBRARY
// ============================================

model Media {
  id        String   @id @default(cuid())
  url       String
  key       String?
  alt       String   @default("")
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  hero    HeroSection?
  about   AboutSection?
  project Project?
  journal JournalPost?
}

// ============================================
// CONTENT: singletons
// ============================================

model HeroSection {
  id                String   @id @default(cuid())
  name              String   @default("Vincent Omolo")
  title             String   @default("Creative Designer & Digital Craftsman")
  description       String   @default("I partner with forward-thinking teams to create digital products and brands that are elegant, intuitive, and built to last.")
  primaryCtaText    String   @default("View Work")
  primaryCtaLink    String   @default("#work")
  secondaryCtaText  String   @default("About Me")
  secondaryCtaLink  String   @default("#about")
  imageId           String?  @unique
  image             Media?   @relation(fields: [imageId], references: [id])
  updatedAt         DateTime @updatedAt
}

model AboutSection {
  id        String   @id @default(cuid())
  headline  String   @default("I design digital experiences that blend strategy, aesthetics, and technology.")
  body      String   @default("With a growing foundation in leading initiatives and crafting considered digital solutions, I help ideas turn into clear, beautiful, and impactful outcomes.")
  linkText  String   @default("More about my approach")
  linkHref  String   @default("#")
  imageId   String?  @unique
  image     Media?   @relation(fields: [imageId], references: [id])
  updatedAt DateTime @updatedAt
}

model FooterContent {
  id        String   @id @default(cuid())
  tagline   String   @default("Designing what matters. Building with intention.")
  email     String   @default("hello@vincentomolo.com")
  linkedin  String?
  whatsapp  String?
  telegram  String?
  behance   String?
  instagram String?
  copyright String   @default("Vincent Omolo. All rights reserved.")
  updatedAt DateTime @updatedAt
}

// ============================================
// CONTENT: repeatable collections
// ============================================

model Project {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  link        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  imageId     String?  @unique
  image       Media?   @relation(fields: [imageId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  iconName    String
  order       Int     @default(0)
  published   Boolean @default(true)

  @@index([order])
}

model JournalPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  date      DateTime @default(now())
  excerpt   String
  body      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  imageId   String?  @unique
  image     Media?   @relation(fields: [imageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ============================================
// ANALYTICS
// ============================================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String
  section   String?
  referrer  String?
  device    String?
  country   String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([sessionId])
}
